PORT=3001
NODE_ENV=development

# PostgreSQL (Docker defaults from infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://second_memory:second_memory_dev@localhost:5432/second_memory

# Redis (Docker defaults from infra/docker/docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Firebase (must match web/mobile Firebase project)
FIREBASE_PROJECT_ID=

# Comma-separated browser origins allowed for local web dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
