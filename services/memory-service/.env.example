# Server
PORT=3001

# Database
DATABASE_URL=postgresql://second_memory:second_memory_dev@localhost:5432/second_memory

# Redis (BullMQ outbox relay)
REDIS_URL=redis://localhost:6379

# Firebase Auth (required for protected routes)
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embedding service (worker-embeddings HTTP server)
EMBEDDING_BASE_URL=http://localhost:8090

# Memory search: minimum similarity score (0–1) to include a result
MIN_SEARCH_SCORE=0
