# Server
PORT=3001

# Database
DATABASE_URL=postgresql://second_memory:second_memory_dev@localhost:5432/second_memory

# Redis (BullMQ outbox relay)
REDIS_URL=redis://localhost:6379

# Firebase Auth (required for protected routes)
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embedding service (OpenAI-compatible /v1/embeddings, 1536 dims)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-...

# Vector indexing: inline (sync in memory-service) or worker (async via BullMQ)
# inline mode does not require REDIS_URL or the Python queue consumer
EMBEDDING_STORAGE_MODE=inline

# Local worker fallback (optional; requires matching pgvector dimensions and re-embedding)
# EMBEDDING_BASE_URL=http://localhost:8090/v1
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_STORAGE_MODE=worker

# Memory search: minimum similarity score (0–1) to include a result
MIN_SEARCH_SCORE=0
