# Shared settings
AWS_ACCOUNT=123456789012
AWS_REGION=ap-northeast-1
FIREBASE_PROJECT_ID=your-firebase-project
CORS_ORIGINS=https://app.example.com,https://your-preview.vercel.app
DATABASE_URL_PARAMETER_NAME=/second-memory/shared/database-url
# SSM_PARAMETER_KMS_KEY_ARN=arn:aws:kms:ap-northeast-1:123456789012:key/your-key-id
# ALARM_TOPIC_ARN=arn:aws:sns:ap-northeast-1:123456789012:your-alerts-topic

# Memory service settings
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY_PARAMETER_NAME=/second-memory/memory-service/embedding-api-key
# Both functions default to dist/assets/memory-service.zip. Set a path to pin a function to an archived ZIP.
# MEMORY_ARTIFACT_PATH=path/to/archived-public-memory.zip
# INTERNAL_MEMORY_ARTIFACT_PATH=path/to/archived-internal-memory.zip

# Ask service settings
ASK_OPENAI_BASE_URL=https://api.openai.com/v1
ASK_OPENAI_MODEL=gpt-6-luna
ASK_OPENAI_API_KEY_PARAMETER_NAME=/second-memory/ask-service/chat-api-key
# ASK_SSM_PARAMETER_KMS_KEY_ARN=arn:aws:kms:ap-southeast-2:123456789012:key/your-key-id
# ASK_ARTIFACT_PATH=dist/assets/ask-service.zip

# User service uses the shared database and Firebase settings.
# USER_ARTIFACT_PATH=dist/assets/user-service.zip
